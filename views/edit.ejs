<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book List Edit Page</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="form-page">
    <section class="form-shell">
      <a href="/books/<%= book._id %>" class="back-link">← Back to Book</a>
      <p class="kicker">Dr. Chantell's Library Book Catalog • UPDATE • PUT</p>
      <h1>Book List Edit Page</h1>
      <h2>Edit Book</h2>
      <p class="form-intro">This form is pre-populated from MongoDB. It sends POST and method-override changes it to PUT.</p>

      <div class="isbn-lookup">
        <div>
          <label for="lookupIsbn">Server-to-Server ISBN Lookup</label>
          <input id="lookupIsbn" type="text" value="<%= book.isbn || '' %>" placeholder="Enter ISBN">
        </div>
        <button id="lookupBookBtn" type="button">Refresh Book Info</button>
      </div>

      <form action="/books/<%=book._id%>?_method=PUT" method="POST" class="book-form" data-book-form>
        <label class="span-2"><span>Title *</span><input id="title" type="text" name="title" value="<%=book.title%>" required></label>
        <label><span>Author *</span><input id="author" type="text" name="author" value="<%=book.author%>" required></label>
        <label><span>ISBN</span><input id="isbn" type="text" name="isbn" value="<%=book.isbn || ''%>"></label>
        <label><span>Genre</span><input id="genre" type="text" name="genre" value="<%=book.genre || ''%>"></label>
        <label><span>Call Number</span><input id="callNumber" type="text" name="callNumber" value="<%=book.callNumber || ''%>"></label>
        <label>
          <span>Format</span>
          <select id="format" name="format">
            <% ["Hardcover","Paperback","eBook","Audiobook","DVD","Other"].forEach(option => { %>
              <option value="<%= option %>" <%= book.format === option ? "selected" : "" %>><%= option %></option>
            <% }) %>
          </select>
        </label>
        <label>
          <span>Status</span>
          <select id="status" name="status">
            <% ["Available","Checked Out","On Hold","Processing","Lost"].forEach(option => { %>
              <option value="<%= option %>" <%= book.status === option ? "selected" : "" %>><%= option %></option>
            <% }) %>
          </select>
        </label>
        <label><span>Branch</span><input id="branch" type="text" name="branch" value="<%=book.branch || 'Main Library'%>"></label>
        <label><span>Shelf Location</span><input id="shelfLocation" type="text" name="shelfLocation" value="<%=book.shelfLocation || ''%>"></label>
        <label><span>Published Date</span><input id="publishedDate" type="date" name="publishedDate" value="<%= book.publishedDate ? new Date(book.publishedDate).toISOString().slice(0,10) : '' %>"></label>
        <label><span>Due Date</span><input id="dueDate" type="date" name="dueDate" value="<%= book.dueDate ? new Date(book.dueDate).toISOString().slice(0,10) : '' %>"></label>
        <label><span>Total Copies</span><input id="totalCopies" type="number" name="totalCopies" min="0" value="<%=book.totalCopies%>"></label>
        <label><span>Available Copies</span><input id="availableCopies" type="number" name="availableCopies" min="0" value="<%=book.availableCopies%>"></label>
        <label><span>Circulation Count</span><input id="circulationCount" type="number" name="circulationCount" min="0" value="<%=book.circulationCount%>"></label>
        <label><span>Cover Image URL</span><input id="coverImage" type="url" name="coverImage" value="<%=book.coverImage || ''%>"></label>
        <label class="span-2"><span>Tags</span><input id="tags" type="text" name="tags" value="<%=(book.tags || []).join(', ')%>"></label>
        <label class="span-2">
          <span>Short Summary</span>
          <textarea id="summary" name="summary" maxlength="500" rows="5"><%=book.summary || ''%></textarea>
          <small id="summaryCount"><%=(book.summary || '').length%> / 500</small>
        </label>
        <label class="checkbox-row span-2">
          <input type="checkbox" name="completed" <% if(book.completed === true){ %> checked <% } %>>
          <span>Catalog record completed</span>
        </label>

        <div class="form-actions span-2">
          <a href="/books/<%=book._id%>" class="cancel-button">Cancel</a>
          <button type="submit" class="pink-button">Submit Changes</button>
        </div>
      </form>
    </section>
  </main>
  <script src="/catalog.js"></script>
</body>
</html>